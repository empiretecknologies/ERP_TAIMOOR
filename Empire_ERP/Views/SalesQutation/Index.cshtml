@section InLineStyleSection {
    <style>
        .sq-page {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 175px);
            min-height: 480px;
            background: #f3f5f7;
            border-radius: 8px;
            overflow: hidden;
        }

        .sq-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 12px;
            background: #fff;
            border-bottom: 1px solid #e5e9ee;
        }

        .sq-toolbar .btn {
            font-size: 12px;
        }

        .sq-hidden {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }

        .sq-body {
            display: flex;
            flex: 1;
            min-height: 0;
        }

        .sq-groups {
            width: 240px;
            flex-shrink: 0;
            background: #fff;
            border-right: 1px solid #e5e9ee;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .sq-panel-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #1f2a37;
            padding: 12px 14px 8px;
            margin: 0;
        }

        .sq-group-list {
            overflow-y: auto;
            padding: 4px 10px 12px;
            flex: 1;
        }

        .sq-group {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            border: 1px solid transparent;
            background: transparent;
            border-radius: 8px;
            padding: 8px 24px 8px 10px;
            text-align: left;
            position: relative;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .sq-group:hover {
            background: #f4f8fb;
        }

        .sq-group.active,
        .sq-group.has-data {
            background: #e8f2f8;
            border-color: #c5dce9;
        }

        .sq-group.active:after {
            content: "";
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            border-top: 6px solid transparent;
            border-bottom: 6px solid transparent;
            border-left: 7px solid var(--theme-blue);
        }

        .sq-group-thumb,
        .sq-item-thumb {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            background: #f0f3f6;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
            position: relative;
        }

        .sq-item-thumb {
            width: 100%;
            height: 92px;
            border-radius: 8px 8px 0 0;
        }

        .sq-group-thumb img,
        .sq-item-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .sq-thumb-fallback {
            width: 100%;
            height: 100%;
            display: none;
            align-items: center;
            justify-content: center;
            color: var(--theme-blue);
            font-size: 18px;
            background: #eef4f8;
        }

        .sq-item-thumb .sq-thumb-fallback {
            font-size: 28px;
        }

        .sq-group-name {
            font-size: 12px;
            font-weight: 700;
            color: #1f2a37;
            line-height: 1.2;
        }

        .sq-group-count {
            font-size: 11px;
            color: #6b7785;
        }

        .sq-items {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            min-height: 0;
            padding: 10px 14px 0;
        }

        .sq-items-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 2px 0 10px;
        }

        .sq-items-title {
            font-size: 15px;
            font-weight: 700;
            color: #1f2a37;
            margin: 0;
        }

        .sq-item-list {
            overflow-y: auto;
            flex: 1;
            min-height: 0;
            padding-bottom: 10px;
        }

        .sq-item-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
            gap: 12px;
        }

        .sq-item-card {
            background: #fff;
            border: 1px solid #e5e9ee;
            border-radius: 10px;
            padding: 0 0 10px;
            display: flex;
            flex-direction: column;
            position: relative;
            cursor: pointer;
            user-select: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
        }

        .sq-item-card:hover {
            border-color: #b9d0de;
            box-shadow: 0 2px 8px rgba(5, 90, 135, 0.08);
        }

        .sq-item-card:active {
            transform: scale(0.98);
        }

        .sq-item-card.selected {
            border-color: var(--theme-blue);
            background: #f4f9fc;
            box-shadow: 0 0 0 2px rgba(5, 90, 135, 0.18);
        }

        .sq-qty-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 2px;
            min-height: 26px;
            padding: 0 8px;
            border-radius: 13px;
            background: #edf1f4;
            color: #5b6773;
            font-size: 12px;
            font-weight: 700;
        }

        .sq-item-card.selected .sq-qty-badge {
            background: var(--theme-blue);
            color: #fff;
        }

        .sq-qty-minus {
            display: none;
            width: 18px;
            height: 18px;
            border: none;
            background: rgba(255, 255, 255, 0.22);
            color: inherit;
            border-radius: 50%;
            font-size: 14px;
            line-height: 1;
            padding: 0;
            align-items: center;
            justify-content: center;
            margin-right: 2px;
        }

        .sq-item-card.selected .sq-qty-minus {
            display: inline-flex;
        }

        .sq-item-body {
            padding: 8px 10px 0;
            min-width: 0;
        }

        .sq-item-name {
            font-size: 13px;
            font-weight: 700;
            color: #1f2a37;
            line-height: 1.25;
            margin: 0 0 4px;
            min-height: 32px;
        }

        .sq-item-rate {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 0;
        }

        .sq-item-rate label {
            font-size: 11px;
            font-weight: 600;
            margin: 0;
            color: #5b6773;
        }

        .sq-rate-input {
            width: 88px;
            height: 26px;
            border: 1px solid #d5dde4;
            border-radius: 4px;
            text-align: right;
            font-size: 12px;
            font-weight: 600;
            color: var(--theme-blue);
            padding: 0 6px;
        }

        .sq-empty {
            color: #6b7785;
            font-size: 12px;
            padding: 18px 8px;
        }

        .sq-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 12px;
            padding: 10px 14px;
            background: #fff;
            border-top: 1px solid #e5e9ee;
            flex-shrink: 0;
        }

        .sq-summary {
            font-size: 13px;
            font-weight: 600;
            color: #1f2a37;
        }

        .sq-footer .btn-save,
        .sq-footer .btn-print {
            min-width: 110px;
        }

        #SaveQuotationModal .modal-header {
            background: var(--theme-blue);
            color: #fff;
        }

        #SaveQuotationModal .modal-title {
            font-size: 15px;
        }

        #SaveQuotationModal .btn-close {
            filter: invert(1);
        }

        #SaveQuotationModal .modal-dialog,
        #SaveQuotationModal .modal-content,
        #SaveQuotationModal .modal-body {
            overflow: visible;
        }

        @@media (max-width: 991px) {
            .sq-page {
                height: auto;
                min-height: 0;
                overflow: visible;
            }

            .sq-body {
                flex-direction: column;
            }

            .sq-groups {
                width: 100%;
                border-right: 0;
                border-bottom: 1px solid #e5e9ee;
            }

            .sq-group-list {
                display: flex;
                overflow-x: auto;
                overflow-y: hidden;
                gap: 6px;
                padding: 0 10px 10px;
            }

            .sq-group {
                min-width: 160px;
                margin-bottom: 0;
            }

            .sq-item-list {
                min-height: 280px;
            }
        }

        @@media (max-width: 575px) {
            .sq-item-grid {
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            }

            .sq-footer {
                justify-content: space-between;
            }

            .sq-footer .btn {
                width: 100%;
            }
        }
    </style>
}

<div class="sq-page Record">
    <div class="sq-toolbar">
        <button type="button" class="btn btn-light btn-search waves-effect waves-light" data-bs-toggle="modal"
                data-bs-target=".bs-example-modal-xl" id="BtnQuickSearch">
            <i class="fa fa-search"></i> Quick Search
        </button>
        <div>
            <button class="btn btn-danger btn-delete" id="BtnDelete" style="display:none"><i class="fa fa-trash"></i> Delete</button>
            <button type="button" class="btn btn-primary btn-new waves-effect waves-light" id="BtnNew">
                <i class="fa fa-plus"></i> Add New
            </button>
        </div>
    </div>

    <div class="sq-hidden">
        <input id="ID" hidden />
        <input id="partyhidden" hidden />
        <input id="acthidden" hidden />
        <input id="Code" readonly type="text" autocomplete="off">
        <div id="ASTATUS"></div>
    </div>

    <div class="sq-body">
        <aside class="sq-groups">
            <h2 class="sq-panel-title">Item Groups</h2>
            <div class="sq-group-list" id="sqGroupList"></div>
        </aside>
        <section class="sq-items">
            <div class="sq-items-head">
                <h2 class="sq-items-title" id="sqItemListTitle">Item List</h2>
            </div>
            <div class="sq-item-list" id="sqItemList"></div>
        </section>
    </div>

    <div class="sq-footer">
        <div class="sq-summary" id="sqSummary">Total Items: 0 | Total Amount: 0.00</div>
        <button type="button" class="btn btn-success btn-print" id="BtnPrint" style="display:none"><i class="fa fa-print"></i> Print</button>
        <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Next -></button>
    </div>
</div>

<div class="modal fade" id="SaveQuotationModal" tabindex="-1" role="dialog" aria-labelledby="SaveQuotationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="SaveQuotationModalLabel">Save Quotation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label" for="VOUCHER_NO">Voucher No</label>
                        <input class="form-control" id="VOUCHER_NO" type="text" readonly autocomplete="off">
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label" for="V_DATE">Date</label>
                        <input class="form-control" id="V_DATE" type="date" value="@DateTime.Now.Date.ToString("yyyy-MM-dd")" autocomplete="off">
                    </div>
                    <div class="col-12 mb-2">
                        <label class="form-label" for="PARTY_CODE">Party</label>
                        <div id="PARTY_CODE"></div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="REMARKS">Remarks</label>
                        <textarea class="form-control" id="REMARKS" rows="3" autocomplete="off"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="BtnModalSave"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Quick Search</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <div class="card text-left">
                        <div class="card-body">
                            <div class="table-responsive">
                                <div id="gridContainer"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade bs-example-modal-xl" id="ShowReportModal" style="display:none" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myExtraLargeModalLabel">Print Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-md-10">
                    <div class="row">
                        <div class="col-xl-4">
                            <label class="form-label" for="ReportType">ReportType:</label>
                            <div id="ReportType"></div>
                        </div>
                        <div class="col-xl-2 mt-20">
                            <button type="button" class="btn btn-primary mr-5" data-bs-toggle="modal" id="BtnGenerateReport">
                                <i class="fa fa-file-arrow-down"></i> Get Report
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mt-3">
                    <div class="card text-left" id="ModalBody">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section LinkScriptSection{
    <script type="text/javascript">
        var Items = @Html.Raw(Json.Serialize(ViewBag.Items));
        var PartyType = @Html.Raw(Json.Serialize(ViewBag.PartyType));
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
        var Limit = @Html.Raw(Json.Serialize(ViewBag.Limit));
        var ItemsGroup = @Html.Raw(Json.Serialize(ViewBag.ItemsGroup));
        var todayDate = '@DateTime.Now.Date.ToString("yyyy-MM-dd")';
        var dataClear = @Html.Raw(Json.Serialize(ViewBag.DATA_CLEAR));
    </script>
    <script src="~/js/customjs/empr_SalesQutation.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            empr_SalesQutation.InitEvents();
        });
    </script>
}
